# Salin file ini ke .env lalu isi nilainya: cp .env.example .env

# Port server (default 3000)
PORT=3000

# Password admin WAJIB diubah sebelum production.
# Di development, jika kosong, default: kickstorm-admin
ADMIN_PASSWORD=Ayet-Lex

# Masa berlaku token admin dalam jam (default 72 = 3 hari)
ADMIN_TOKEN_TTL_HOURS=72

# development | production (production memaksa ADMIN_PASSWORD terisi)
NODE_ENV=development

# ====================================================================
# DATABASE CLOUD (PILIHAN UTAMA: SUPABASE)
# ====================================================================
# Dapatkan gratis di https://supabase.com (Project Settings > API)
SUPABASE_URL=
SUPABASE_KEY=

# (Alternatif) Turso Database Cloud
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# (Opsional) Lokasi file SQLite lokal offline. Default: data/kickstorm.db
# DB_PATH=data/kickstorm.db

# Google Maps JavaScript API key (Maps JavaScript API + Places API).
# Kosongkan jika belum punya — form alamat tetap jalan sebagai teks biasa & link native Google Maps.
# RESTRIKSI KEY: di Google Cloud Console batasi ke "HTTP referrers" domain situsmu.
GOOGLE_MAPS_API_KEY=